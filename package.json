{
  "name": "clearframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent": "tsx --env-file-if-exists=.env packages/core/scripts/run-agent.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run-evals.ts",
    "eval:no-rule": "tsx --env-file-if-exists=.env evals/run-evals.ts --no-rule",
    "catalog:generate": "tsx packages/core/scripts/generate-catalog.ts",
    "catalog:embed": "tsx --env-file-if-exists=.env packages/core/scripts/embed-catalog.ts",
    "build:lambda": "pnpm --filter @clearframe/api build",
    "web:dev": "pnpm --filter @clearframe/web dev",
    "web:build": "pnpm --filter @clearframe/web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
